{
  "manifest_version": 3,
  "name": "Scholar Sidekick",
  "version": "1.0.0",
  "description": "Finds relevant papers, books, and Stack Exchange discussions for whatever you're studying or working on.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://localhost:3000/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Scholar Sidekick"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
